<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Engine\TalesOfTribute.csproj" />
      <ProjectReference Include="..\gRPC\gRPC.csproj" />
      <!-- Forces build ordering (Bots builds before GameRunner) without a
           compile-time reference, so bots stay dynamically loaded at runtime
           via reflection (see Program.cs) rather than statically linked. -->
      <ProjectReference Include="..\Bots\Bots.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <!-- GameRunner loads Bots.dll by reflection, so NuGet never places
           OnnxRuntime next to it. This reference puts Microsoft.ML.OnnxRuntime.dll
           and runtimes/<rid>/native/libonnxruntime.* in GameRunner's output, where
           the loaded bot finds them. See README, "OnnxRuntime native library caveat". -->
      <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    </ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    </ItemGroup>

    <ItemGroup>
      <!-- Bots.dll is built, not committed. The path follows GameRunner's own
           $(Configuration), because a Debug Bots.dll under a Release GameRunner
           runs the wall-clock-budgeted search without JIT optimizations. -->
      <None Include="..\Bots\bin\$(Configuration)\netstandard2.1\Bots.dll">
        <Link>Bots\Bots.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <!-- The bots resolve the model against AppContext.BaseDirectory, which
           for a dynamically-loaded bot is GameRunner's own output directory,
           not the directory Bots.dll came from. So the model has to land here. -->
      <None Include="..\models\DeepSetsValueNetwork.onnx">
        <Link>DeepSetsValueNetwork.onnx</Link>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
